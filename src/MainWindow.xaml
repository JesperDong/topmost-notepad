<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit"
      Background="#FFFEFC">
  <Grid.Resources>
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Foreground" Value="#344151"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E9EDF1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DEE5ED"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#7899C7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PinButton" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#3E4B59"/>
      <Setter Property="Background" Value="#EFF1F3"/>
      <Setter Property="BorderBrush" Value="#DCE1E7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E8F0FC"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#BCD0EB"/>
                <Setter Property="Foreground" Value="#245B9C"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#507CB6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#F5F6F7" BorderBrush="#E4E7EB" BorderThickness="0,0,0,1">
    <Grid Margin="10,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="NewButton" Style="{StaticResource ToolbarButton}" ToolTip="新建笔记 (Ctrl+N)" AutomationProperties.Name="新建笔记">
          <StackPanel Orientation="Horizontal"><Path Width="14" Height="16" Margin="0,0,7,0" Stroke="#5C6A7D" StrokeThickness="1.4" Data="M2,1 L9,1 L13,5 L13,15 L2,15 Z M9,1 L9,5 L13,5 M5,8 L10,8 M5,11 L10,11"/><TextBlock Text="新建"/></StackPanel>
        </Button>
        <Button x:Name="OpenButton" Style="{StaticResource ToolbarButton}" ToolTip="打开 TXT 文件 (Ctrl+O)" AutomationProperties.Name="打开文件">
          <StackPanel Orientation="Horizontal"><Path Width="17" Height="16" Margin="0,0,7,0" Stroke="#5C6A7D" StrokeThickness="1.4" Data="M1,12 L1,3 L6,3 L8,5 L15,5 L15,7 M1,14 L4,7 L17,7 L14,14 Z"/><TextBlock Text="打开"/></StackPanel>
        </Button>
        <Button x:Name="SaveButton" Style="{StaticResource ToolbarButton}" Margin="0" ToolTip="保存笔记 (Ctrl+S)" AutomationProperties.Name="保存文件">
          <StackPanel Orientation="Horizontal"><Path Width="15" Height="16" Margin="0,0,7,0" Stroke="#5C6A7D" StrokeThickness="1.4" Data="M1,1 L11,1 L14,4 L14,15 L1,15 Z M4,1 L4,6 L10,6 L10,1 M4,15 L4,9 L11,9 L11,15"/><TextBlock Text="保存"/></StackPanel>
        </Button>
        <Button x:Name="SaveMoreButton" Style="{StaticResource ToolbarButton}" Padding="6,7" ToolTip="另存为 (Ctrl+Shift+S)" AutomationProperties.Name="更多保存选项">
          <Path Width="8" Height="5" Stroke="#5C6A7D" StrokeThickness="1.4" Data="M0,0 L4,4 L8,0"/>
          <Button.ContextMenu><ContextMenu><MenuItem x:Name="SaveAsItem" Header="另存为…" InputGestureText="Ctrl+Shift+S"/></ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
      <ToggleButton x:Name="PinButton" Grid.Column="2" Style="{StaticResource PinButton}" ToolTip="开启后，笔记窗口始终显示在其他普通窗口上方 (Ctrl+T)" IsChecked="True" AutomationProperties.Name="窗口置顶">
        <StackPanel Orientation="Horizontal"><Path Width="14" Height="16" Margin="0,0,7,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" Data="M4,1 L11,1 M5,1 L5,6 L2,10 L13,10 L10,6 L10,1 M7.5,10 L7.5,16"/><TextBlock x:Name="PinLabel" Text="已置顶"/></StackPanel>
      </ToggleButton>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,5,0,0">
        <Button x:Name="KnowledgeButton" Style="{StaticResource ToolbarButton}" Margin="0" ToolTip="选中文字：设为补充知识并收起；未选中文字：插入空白补充块 (Ctrl+Shift+K)" AutomationProperties.Name="添加补充知识折叠块">
          <StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,0,7,0" Stroke="#5C6A7D" StrokeThickness="1.4" Data="M1,2 L14,2 L14,14 L1,14 Z M4,6 L11,6 M7.5,2 L7.5,10"/><TextBlock Text="补充知识"/></StackPanel>
        </Button>
        <Button x:Name="KnowledgeMoreButton" Style="{StaticResource ToolbarButton}" Padding="6,7" ToolTip="折叠与展开选项" AutomationProperties.Name="补充知识折叠选项">
          <Path Width="8" Height="5" Stroke="#5C6A7D" StrokeThickness="1.4" Data="M0,0 L4,4 L8,0"/>
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="展开 / 收起当前块" InputGestureText="Ctrl+Shift+Space"/>
            <MenuItem Header="全部收起" InputGestureText="Ctrl+Shift+1"/>
            <MenuItem Header="全部展开" InputGestureText="Ctrl+Shift+2"/>
            <Separator/>
            <MenuItem Header="取消当前折叠（保留文字）" InputGestureText="Ctrl+Shift+U"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <TextBlock Text="选中内容，再设为补充知识" Foreground="#929DA9" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="12,18,12,14">
    <edit:TextEditor x:Name="Editor" Background="Transparent" Foreground="#27313E" BorderThickness="0" Padding="0" FontFamily="Microsoft YaHei UI" FontSize="16" WordWrap="True" ShowLineNumbers="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="笔记内容"/>
    <TextBlock x:Name="Placeholder" Text="在这里记下想法…" Foreground="#9AA3AD" FontSize="16" IsHitTestVisible="False" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#E8EAED" BorderThickness="0,1,0,0" Background="#F8F9FA" Padding="16,7">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="尚未保存 · UTF-8" Foreground="#7A8592" FontSize="11" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="CountText" Grid.Column="1" Text="0 字" Foreground="#7A8592" FontSize="11" Margin="12,0,0,0"/>
    </Grid>
  </Border>
</Grid>
